#!/bin/sh
# 守卫：禁止包含真实姓名/公司邮箱的提交进入历史
# 关键词用分段拼接，避免脚本自身被扫描命中
A="xie""jianjun"
B="jian""jun.xie"
C="yte""ver.com"
FORBIDDEN="$A|$B|$C"

# 凭据泄漏：npm token / 常见私钥头
SECRET="npm_[A-Za-z0-9]{20,}|_authToken=|-----BEGIN [A-Z ]*PRIVATE KEY-----"

if git diff --cached --name-only | grep -v '^\.githooks/' | xargs -r grep -lEi "$FORBIDDEN" 2>/dev/null | grep -q .; then
  echo "❌ 提交被阻止：暂存区文件包含真实姓名或公司邮箱"
  exit 1
fi

if git diff --cached --name-only | grep -v '^\.githooks/' | xargs -r grep -lE "$SECRET" 2>/dev/null | grep -q .; then
  echo "❌ 提交被阻止：暂存区文件包含凭据（npm token 或私钥）"
  exit 1
fi
for field in GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL; do
  eval "val=\$$field"
  if echo "$val" | grep -Eqi "$FORBIDDEN"; then
    echo "❌ 提交被阻止：$field 包含真实姓名或公司邮箱"
    exit 1
  fi
done
exit 0

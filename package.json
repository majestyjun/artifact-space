{
  "name": "@xxjxx/artifact-space",
  "version": "1.4.0",
  "description": "产物空间：为 DSH 侧栏增加一个入口，按工作区与会话隔离列出每个会话的最终有效产物，支持预览、搜索与收藏。",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/majestyjun/artifact-space#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/majestyjun/artifact-space.git"
  },
  "bugs": {
    "url": "https://github.com/majestyjun/artifact-space/issues"
  },
  "keywords": [
    "artifact",
    "artifact-space",
    "workspace",
    "session",
    "preview",
    "favorites",
    "deliverables"
  ],
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "README.md",
    "README.en.md",
    "README.i18n.yaml",
    "LICENSE",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "docs/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.1.5-alpha.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-session": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-query": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-workspace": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-workspace-files": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-fs": "^0.2.1-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-workspace-files": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox-policy": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    }
  },
  "author": "majestyjun"
}
